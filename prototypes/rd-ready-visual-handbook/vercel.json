{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build:cloud",
 "outputDirectory":"dist/client",
 "regions":["sin1"],
 "functions":{"api/*.ts":{"maxDuration":30,"includeFiles":"data/deploy/**"}},
 "routes":[{"handle":"filesystem"},{"src":"/api/.*","dest":"/api/not-found"},{"src":"/.*","dest":"/index.html"}]
}
