{
  "name": "rd-ready-visual-handbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "node qa/pack-go-browser.mjs",
    "test:packing": "node ../../node_modules/tsx/dist/cli.mjs --test server/packing-items.test.ts",
    "test:items:ui": "node qa/item-details-browser.mjs",
    "test:preserve": "node qa/preservation-check.mjs",
    "serve": "node --watch --watch-path=.env.local --watch-path=server --watch-path=src/search.ts ../../node_modules/tsx/dist/cli.mjs server/local.ts",
    "test:assistant": "node ../../node_modules/tsx/dist/cli.mjs --test server/assistant.test.ts server/local.test.ts server/research.test.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:assistant:ui": "node qa/assistant-browser.mjs",
    "test:research:ui": "node qa/research-browser.mjs",
    "test:questions": "node ../../node_modules/tsx/dist/cli.mjs qa/question-eval.ts",
    "prepare:deploy-data": "node ../../node_modules/tsx/dist/cli.mjs scripts/export-deploy-data.ts",
    "build:cloud": "vite build",
    "db:import": "node ../../node_modules/tsx/dist/cli.mjs scripts/import-supabase.ts",
    "test:cloud": "node ../../node_modules/tsx/dist/cli.mjs --test server/cloud.test.ts",
    "test:cloud:ui": "node qa/cloud-browser.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "minisearch": "^7.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
